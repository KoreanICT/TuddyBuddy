<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.ictedu.back.common.dao.CommunityDao">

    <!-- 1. 게시글 쓰기 -->
    <insert id="insertPost" parameterType="kr.co.ictedu.back.common.vo.CommunityVO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO community (
            title, 
            content, 
            nickname, 
            category
        ) VALUES (
            #{title}, 
            #{content}, 
            #{nickname}, 
            #{category}
        )
    </insert>

    <!-- 2. 게시글 삭제하기 -->
    <delete id="deletePost" parameterType="int">
        DELETE FROM community 
        WHERE id = #{id}
    </delete>

    <!-- 3. 댓글 쓰기 -->
    <!-- 댓글도 별도의 테이블이 있거나 community 테이블 구조를 활용한다고 가정합니다. 
         여기서는 예시로 comment 테이블에 삽입하는 쿼리로 작성했습니다. -->
    <insert id="insertComment">
        INSERT INTO community_comment (
            post_id, 
            content, 
            nickname
        ) VALUES (
            #{postId}, 
            #{comment.content}, 
            #{comment.nickname}
        )
    </insert>

    <!-- 4. 댓글 삭제 -->
    <delete id="deleteComment" parameterType="int">
        DELETE FROM community_comment 
        WHERE id = #{commentId}
    </delete>

    <!-- 5. 임시글 작성 -->
    <!-- 임시글 상태를 구분하는 컬럼(예: status = 'TEMP')이 있다고 가정합니다. -->
    <insert id="insertTempPost" parameterType="kr.co.ictedu.back.common.vo.CommunityVO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO community (
            title, 
            content, 
            nickname, 
            category, 
            status
        ) VALUES (
            #{title}, 
            #{content}, 
            #{nickname}, 
            #{category}, 
            'TEMP'
        )
    </insert>

</mapper>